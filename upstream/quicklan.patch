+//! QuickLAN scope checks, applied to plaintext before TUN delivery / encryption.
+use cidr::Ipv4Inet;
+use std::net::Ipv4Addr;
+pub fn allow_ipv4(packet: &[u8], proposal: Option<Ipv4Inet>, local: Option<Ipv4Inet>, inbound: bool) -> bool {
+    let (Some(proposal), Some(local)) = (proposal, local) else { return false; };
+    if packet.len() < 20 || packet[0] >> 4 != 4 { return false; }
+    let header = (packet[0] & 15) as usize * 4;
+    let total = u16::from_be_bytes([packet[2], packet[3]]) as usize;
+    if header < 20 || header > packet.len() || total < header || total > packet.len() { return false; }
+    let src = Ipv4Addr::new(packet[12], packet[13], packet[14], packet[15]);
+    let dst = Ipv4Addr::new(packet[16], packet[17], packet[18], packet[19]);
+    let host = |ip: &Ipv4Addr| proposal.contains(ip) && *ip != proposal.first_address() && *ip != proposal.last_address();
+    host(&src) && host(&dst) && if inbound { dst == local.address() } else { src == local.address() }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_foreign_subnets_ipv6_and_wrong_local_direction() {
+        let proposal = Some("10.73.42.0/24".parse().unwrap());
+        let local = Some("10.73.42.1/24".parse().unwrap());
+        let mut p = [0u8; 20]; p[0] = 0x45; p[3] = 20;
+        p[12..16].copy_from_slice(&[10,73,42,1]); p[16..20].copy_from_slice(&[10,73,42,2]);
+        assert!(allow_ipv4(&p, proposal, local, false));
+        assert!(!allow_ipv4(&p, proposal, local, true));
+        p[16] = 8; assert!(!allow_ipv4(&p, proposal, local, false));
+        p[16] = 10; p[19] = 255; assert!(!allow_ipv4(&p, proposal, local, false));
+        p[0] = 0x60; assert!(!allow_ipv4(&p, proposal, local, false));
+    }
+}
