+// SPDX-License-Identifier: LGPL-3.0-only
+//! System DNS only. No implicit resolver operators or DNS-record tunnels.
+use std::net::{IpAddr, SocketAddr};
+use super::error::Error;
+pub async fn resolve_txt_record(_: &str) -> Result<String, Error> {
+    Err(Error::InvalidUrl("DNS record discovery is disabled".into()))
+}
+pub async fn socket_addrs(url: &url::Url, default_port: impl Fn() -> Option<u16>) -> Result<Vec<SocketAddr>, Error> {
+    let host = url.host().ok_or_else(|| Error::InvalidUrl("Missing host".into()))?;
